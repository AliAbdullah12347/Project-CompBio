<mxfile host="app.diagrams.net" type="device">
  <diagram id="netarm" name="Network Analysis Arm">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;NETWORK ANALYSIS ARM&lt;/b&gt;" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1080" height="30" as="geometry" /></mxCell>
        <mxCell id="groups" value="Define 3 groups: Healthy no lithium,&lt;br&gt;BP no lithium, BP lithium" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="76" width="460" height="46" as="geometry" /></mxCell>
        <mxCell id="n1" value="234 controls, 74 BP1 off lithium,&lt;br&gt;152 BP1 on lithium." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="290" height="38" as="geometry" /></mxCell>
        <mxCell id="sub" value="Subsample the two larger groups down to n = 74 to match the&lt;br&gt;smallest group, then do 100 draws" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="162" width="460" height="64" as="geometry" /></mxCell>
        <mxCell id="n2" value="BP1 off lithium is never subsampled — it&lt;br&gt;already is 74. Draws equalise group size;&lt;br&gt;they are not independent replicates: two&lt;br&gt;draws from the 152 share ~36 people.&lt;br&gt;100 draws here; D = 20 inside the&lt;br&gt;permutation test below." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="158" width="290" height="86" as="geometry" /></mxCell>
        <mxCell id="mods" value="Define the modules ONCE, on the reference group, then measure&lt;br&gt;those same modules in every draw.&lt;br&gt;&lt;br&gt;Gene-to-gene correlation → weighted network (WGCNA)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="460" height="80" as="geometry" /></mxCell>
        <mxCell id="n3" value="If modules are re-detected in each draw,&lt;br&gt;module 7 in draw 1 is not module 7 in&lt;br&gt;draw 2, and there is nothing to pool&lt;br&gt;across." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="276" width="290" height="66" as="geometry" /></mxCell>
        <mxCell id="pres" value="Check module preservation across groups and across draws.&lt;br&gt;Zsummary and medianRank are DESCRIPTIVE scores only." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="398" width="460" height="64" as="geometry" /></mxCell>
        <mxCell id="n4" value="Zsummary has no calibrated null — Langfelder&lt;br&gt;(2011) gives rule-of-thumb cutoffs, not&lt;br&gt;p-values — and medianRank is relative to&lt;br&gt;one run. Neither can be corrected. This run&lt;br&gt;needs WGCNA&amp;#x27;s internal permutations and is&lt;br&gt;the slow one; time a single draw first." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="392" width="290" height="86" as="geometry" /></mxCell>
        <mxCell id="perm" value="&lt;b&gt;Permutation test — one p-value per module&lt;/b&gt;&lt;br&gt;&lt;br&gt;Statistic:  Δ(M) = preservation in BP-lithium − preservation&lt;br&gt;in BP-no-lithium, averaged over D = 20 draws&lt;br&gt;Null:  relabel the 226 BP1 subjects 152/74 at random, rerun&lt;br&gt;the same D = 20 draws. K = 1,000 relabellings.&lt;br&gt;p = (1 + #{ |Δnull| ≥ |Δobs| }) / (K + 1)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="508" width="460" height="132" as="geometry" /></mxCell>
        <mxCell id="n5" value="Matching D on both sides is what makes&lt;br&gt;pooling valid: draw-to-draw variance enters&lt;br&gt;the null exactly as it enters the observation,&lt;br&gt;so the draws never have to be independent.&lt;br&gt;Run modulePreservation with nPermutations&lt;br&gt;= 0 here — you supply your own null, so each&lt;br&gt;evaluation takes seconds." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="506" width="290" height="100" as="geometry" /></mxCell>
        <mxCell id="bh" value="Benjamini–Hochberg across MODULES (the family is modules,&lt;br&gt;not draws) → which modules differ between groups" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="686" width="460" height="64" as="geometry" /></mxCell>
        <mxCell id="n6" value="~20–40 modules, so BH needs p ≈ 0.002 to&lt;br&gt;survive — hence K = 1,000, since the&lt;br&gt;smallest possible p is 1/(K+1). Use&lt;br&gt;Benjamini–Bogomolov to correct the lithium&lt;br&gt;and diagnosis comparisons together." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="780" y="684" width="290" height="74" as="geometry" /></mxCell>
        <mxCell id="redo" value="Redo with the cell mix removed from the genes (computed using&lt;br&gt;regression) to check whether any detected differences survive&lt;br&gt;once composition is accounted for" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="796" width="460" height="80" as="geometry" /></mxCell>
        <mxCell id="own" value="Note: This is just one possible avenue of&lt;br&gt;network analysis, we aim to explore different&lt;br&gt;avenues such as community detection to see&lt;br&gt;if the samples separate neatly into clusters&lt;br&gt;by diagnosis or by lithium usage or some&lt;br&gt;other factor, we could also check differences&lt;br&gt;in centrality for these networks and see if&lt;br&gt;that tells us anything." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="8" y="290" width="286" height="120" as="geometry" /></mxCell>
        <mxCell id="alt" value="&lt;b&gt;IF YOU PREFER TO KEEP ARM 3 PURELY EXPLORATORY&lt;/b&gt;&lt;br&gt;Drop the permutation test and the Benjamini–Hochberg step. Report median Zsummary per module per group across the 100 draws with a 2.5–97.5 percentile&lt;br&gt;interval, and call a module not preserved only when the whole interval falls below the pre-declared Zsummary &amp;lt; 2 threshold (CLAUDE.md §4.4). No null and no&lt;br&gt;correction are then needed — but you cannot say “differs significantly”, only “consistently below threshold in one group and not the other”. Pick one path." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="10" y="916" width="1060" height="104" as="geometry" /></mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="groups" target="sub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sub" target="mods"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mods" target="pres"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pres" target="perm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="perm" target="bh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bh" target="redo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l0" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="99" as="sourcePoint" /><mxPoint x="760" y="99" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l1" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="194" as="sourcePoint" /><mxPoint x="760" y="194" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="309" as="sourcePoint" /><mxPoint x="760" y="312" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="435" as="sourcePoint" /><mxPoint x="760" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="556" as="sourcePoint" /><mxPoint x="760" y="574" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="721" as="sourcePoint" /><mxPoint x="760" y="718" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
