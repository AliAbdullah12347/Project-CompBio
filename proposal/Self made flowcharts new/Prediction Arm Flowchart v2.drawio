<mxfile host="app.diagrams.net" type="device">
  <diagram id="predarm" name="Prediction Arm">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1015" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;PREDICTION CONTEST ARM&lt;/b&gt;" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="980" height="30" as="geometry" /></mxCell>
        <mxCell id="pop" value="Keep only BP1: where&lt;br&gt;Lithium varies" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="56" width="300" height="56" as="geometry" /></mxCell>
        <mxCell id="n_pop" value="226 samples. 74 not on Lithium,&lt;br&gt;152 on Lithium" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="700" y="68" width="270" height="32" as="geometry" /></mxCell>
        <mxCell id="rep" value="&lt;b&gt;REPEAT 25×  —  a different random partition each time&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E74B5;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#2E74B5;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="620" height="475" as="geometry" /></mxCell>
        <mxCell id="outer" value="Outer split: stratified&lt;br&gt;3-fold CV over all 226" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="196" width="240" height="52" as="geometry" /></mxCell>
        <mxCell id="fold" value="Outer test fold —&lt;br&gt;one third, rotating" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="196" width="200" height="52" as="geometry" /></mxCell>
        <mxCell id="n_fold" value="Replaces the 10% holdout. Every&lt;br&gt;subject lands in the test fold exactly&lt;br&gt;once per repeat, so the evaluation&lt;br&gt;set is all 226 — not 23." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="272" height="76" as="geometry" /></mxCell>
        <mxCell id="ppma" value="PPMa" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="146" y="290" width="80" height="34" as="geometry" /></mxCell>
        <mxCell id="ppmb" value="PPMb" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="290" width="80" height="34" as="geometry" /></mxCell>
        <mxCell id="ppmc" value="PPMc" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="374" y="290" width="80" height="34" as="geometry" /></mxCell>
        <mxCell id="g00" value="Test" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="366" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g01" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="270" y="366" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g02" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="366" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g10" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="390" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g11" value="Test" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="390" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g12" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="390" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g20" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="414" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g21" value="Train" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="270" y="414" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="g22" value="Test" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F2F2F2;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="414" width="60" height="24" as="geometry" /></mxCell>
        <mxCell id="n_cv" value="Do this CV for each&lt;br&gt;of the splits" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E74B5;" vertex="1" parent="1"><mxGeometry x="10" y="372" width="190" height="32" as="geometry" /></mxCell>
        <mxCell id="n_rf" value="Train Using Random Forest&lt;br&gt;and Elastic Net" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#2E74B5;" vertex="1" parent="1"><mxGeometry x="10" y="420" width="190" height="32" as="geometry" /></mxCell>
        <mxCell id="n_tune" value="&lt;b&gt;INNER loop — tuning only.&lt;/b&gt;&lt;br&gt;Within these, tune the&lt;br&gt;hyperparameters to get the&lt;br&gt;best prediction results." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="412" y="368" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="refit" value="Once satisfied, build one new model that runs&lt;br&gt;on the entire outer-training set using the&lt;br&gt;tuned hyperparameters" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="130" y="470" width="340" height="56" as="geometry" /></mxCell>
        <mxCell id="score" value="Test this model on the outer test fold once,&lt;br&gt;and record the AUC for predicting&lt;br&gt;lithium usage" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="130" y="546" width="340" height="56" as="geometry" /></mxCell>
        <mxCell id="boot" value="Pool the out-of-fold predictions from all 25&lt;br&gt;repeats. Bootstrap over subjects (2,000&lt;br&gt;resamples) for a 95% CI on the difference in&lt;br&gt;AUC between inputs." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="110" y="660" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="n_boot" value="This replaces a single accuracy number. Compare the&lt;br&gt;interval with the pre-declared ±0.05 equivalence margin:&lt;br&gt;entirely inside it = equivalent, straddling it = inconclusive." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#C55A11;" vertex="1" parent="1"><mxGeometry x="520" y="662" width="450" height="66" as="geometry" /></mxCell>
        <mxCell id="nA" value="&lt;b&gt;Why the separate 10% test set is gone&lt;/b&gt;&lt;br&gt;A 10% holdout of 226 is about 23 people, roughly 7 lithium&lt;br&gt;non-users. The 95% CI on an AUC that small is about ±0.26,&lt;br&gt;which cannot resolve a ±0.05 equivalence margin. The&lt;br&gt;rotating outer fold tests every one of the 226 instead." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="10" y="770" width="470" height="110" as="geometry" /></mxCell>
        <mxCell id="nB" value="Note: We run the whole pipeline multiple times, once for each&lt;br&gt;input we define in the proposal, at the end, we see which input&lt;br&gt;gives the more accurate prediction." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="500" y="770" width="470" height="110" as="geometry" /></mxCell>
        <mxCell id="nC" value="Note: Could also try to see how accurate each input is at&lt;br&gt;predicting BP diagnoses, which would not require too many&lt;br&gt;changes to this flowchart." style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#C55A11;fontColor=#C55A11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="10" y="900" width="470" height="90" as="geometry" /></mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pop" target="outer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g20" target="refit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="refit" target="score"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="score" target="boot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="outer" target="fold"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fo0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="outer" target="ppma"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ppma" target="g00"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fo1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="outer" target="ppmb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ppmb" target="g00"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fo2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="outer" target="ppmc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fi2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ppmc" target="g00"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l0" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="84" as="sourcePoint" /><mxPoint x="696" y="78" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l1" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="222" as="sourcePoint" /><mxPoint x="698" y="222" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="388" as="sourcePoint" /><mxPoint x="208" y="388" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="436" as="sourcePoint" /><mxPoint x="208" y="400" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="402" as="sourcePoint" /><mxPoint x="410" y="396" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="endArrow=none;html=1;strokeColor=#9A9A9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="694" as="sourcePoint" /><mxPoint x="516" y="694" as="targetPoint" /></mxGeometry></mxCell>
      </root>
